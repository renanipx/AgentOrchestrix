{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentOrchestrixState",
  "description": "Validation schema for the execution state (state.json) of the AgentOrchestrix protocol.",
  "type": "object",
  "required": [
    "run_id",
    "command",
    "goal",
    "status",
    "current_phase",
    "completed_phases",
    "protocol_version",
    "created_at",
    "updated_at",
    "environment_ready",
    "interview_decisions",
    "artifacts",
    "prevention_guardrails",
    "loaded_skills",
    "quality_score",
    "errors"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^run-\\d{3,4}$",
      "description": "Unique identifier of the run (e.g., run-001)"
    },
    "command": {
      "type": "string",
      "enum": ["orchestrate", "plan", "continue-run", "validate-run", "analyze"],
      "description": "Command invoked to initialize or manage the run"
    },
    "goal": {
      "type": "string",
      "description": "Main goal of the run"
    },
    "status": {
      "type": "string",
      "enum": ["created", "waiting_for_user", "running", "blocked", "failed", "completed"],
      "description": "Current state of the run"
    },
    "current_phase": {
      "type": "string",
      "enum": ["0_interview", "1_planner", "2_architect", "3_builder", "4_validator", "5_reviewer", "6_critic", "completed"],
      "description": "Current phase in execution"
    },
    "completed_phases": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["0_interview", "1_planner", "2_architect", "3_builder", "4_validator", "5_reviewer", "6_critic"]
      },
      "description": "Phases that have already been completed"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "AgentOrchestrix protocol version"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of run creation"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last run update"
    },
    "parent_run": {
      "type": ["string", "null"],
      "pattern": "^(run-\\d{3,4})?$",
      "description": "Parent run ID from which this run inherits decisions (if applicable)"
    },
    "environment_ready": {
      "type": ["boolean", "null"],
      "description": "Indicates if the required command line tools are available in the environment"
    },
    "phase_history": {
      "type": "array",
      "description": "Phase transitions and rollback history",
      "items": {
        "type": "object",
        "required": ["phase", "status", "timestamp"],
        "properties": {
          "phase": {
            "type": "string",
            "enum": ["0_interview", "1_planner", "2_architect", "3_builder", "4_validator", "5_reviewer", "6_critic", "completed"]
          },
          "status": {
            "type": "string",
            "enum": ["running", "completed", "failed", "blocked", "waiting_for_user"]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "rollback_changes": {
            "type": "array",
            "description": "List of modified files and rollback reasons in this iteration",
            "items": {
              "type": "object",
              "required": ["file", "reason"],
              "properties": {
                "file": { "type": "string" },
                "reason": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "interview_decisions": {
      "type": "object",
      "description": "Consolidated decisions in Phase 0 (Interview)",
      "required": [
        "scope",
        "acceptance_criteria",
        "integrations_data",
        "constraints",
        "destructive_operations_strategy",
        "storage_strategy",
        "accessibility_level",
        "max_lines_per_file",
        "primary_language",
        "typography_strategy",
        "keyboard_shortcuts",
        "environment_decision"
      ],
      "properties": {
        "language_runtime": {
          "type": ["string", "null"],
          "description": "Deprecated: kept for backward compatibility. Use technology_stack."
        },
        "technology_stack": {
          "type": ["object", "null"],
          "description": "Multiple technology stacks defined for the project",
          "properties": {
            "frontend": {
              "type": ["string", "object", "null"]
            },
            "backend": {
              "type": ["string", "object", "null"]
            },
            "database": {
              "type": ["string", "object", "null"]
            },
            "styling": {
              "type": ["string", "object", "null"]
            }
          },
          "additionalProperties": true
        },
        "scope": {
          "type": ["string", "array", "null"]
        },
        "acceptance_criteria": {
          "type": ["string", "array", "null"]
        },
        "integrations_data": {
          "type": ["string", "array", "null"]
        },
        "constraints": {
          "type": ["string", "array", "null"]
        },
        "destructive_operations_strategy": {
          "type": ["string", "null"]
        },
        "storage_strategy": {
          "type": ["string", "null"]
        },
        "accessibility_level": {
          "type": ["string", "null"]
        },
        "max_lines_per_file": {
          "type": ["integer", "null"]
        },
        "primary_language": {
          "type": ["string", "null"]
        },
        "typography_strategy": {
          "type": ["string", "null"]
        },
        "keyboard_shortcuts": {
          "type": ["string", "array", "null"]
        },
        "environment_decision": {
          "type": ["string", "null"],
          "description": "User decision in case of missing environment tools (e.g., 'proceed_without_runtime')"
        },
        "complex_interactions": {
          "type": ["array", "null"],
          "description": "List of hierarchical interaction level pairs identified in Phase 0 (e.g., ['card-within-column', 'widget-within-panel']). When populated, activates event isolation guardrails in Phases 1 to 6.",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "object",
      "required": ["goal", "task", "architecture", "build_report", "validation_report", "review", "critic"],
      "properties": {
        "goal": { "type": "string" },
        "task": { "type": "string" },
        "architecture": { "type": "string" },
        "build_report": { "type": "string" },
        "validation_report": { "type": "string" },
        "review": { "type": "string" },
        "critic": { "type": "string" },
        "planning_summary": { "type": "string" },
        "handoff": { "type": "string" }
      },
      "additionalProperties": true
    },
    "prevention_guardrails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "loaded_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_score": {
      "type": "object",
      "required": ["visual", "ux", "functionality", "code_quality", "tests", "security"],
      "properties": {
        "visual": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "ux": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "functionality": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "code_quality": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "tests": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "security": { "type": ["number", "null"], "minimum": 0, "maximum": 10 }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "auto_mode": {
      "type": "boolean",
      "description": "Indicates if the run is being executed in autonomous mode in subsequent phases"
    },
    "phase_summaries": {
      "type": "object",
      "description": "Executive summaries of each phase (maximum 2 lines per phase) to avoid re-reading artifacts",
      "properties": {
        "0_interview": { "type": "string" },
        "1_planner": { "type": "string" },
        "2_architect": { "type": "string" },
        "3_builder": { "type": "string" },
        "4_validator": { "type": "string" },
        "5_reviewer": { "type": "string" },
        "6_critic": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
